# Continuum environment

CONTINUUM_MODE=demo
CONTINUUM_SESSION_SECRET=replace-with-long-random-string
# CONTINUUM_DB_PATH=data/continuum.sqlite
# CONTINUUM_COOKIE_SECURE=0          # set 0 for http://localhost under next start
# DATABASE_URL=postgres://...        # required for multi-instance production (not in demo profile)
# CONTINUUM_FAST=1                   # shorten motion sleeps (tests)
# CONTINUUM_AUTO_WORKER=0            # disable background timer (tests)
