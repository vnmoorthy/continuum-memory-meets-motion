# Continuum environment

CONTINUUM_MODE=demo
CONTINUUM_SESSION_SECRET=replace-with-long-random-string
# CONTINUUM_DB_PATH=data/continuum.sqlite
# CONTINUUM_COOKIE_SECURE=0          # set 0 for http://localhost under next start
# DATABASE_URL=postgres://...        # required for multi-instance production (not in demo profile)
# CONTINUUM_FAST=1                   # shorten motion sleeps (tests)
# CONTINUUM_AUTO_WORKER=0            # disable background timer (tests)

# --- Sponsor SDKs (optional; DEMO fallbacks when unset) ---

# RocketRide — AI pipeline cloud
# ROCKETRIDE_APIKEY=
# ROCKETRIDE_URI=https://api.rocketride.ai

# FalkorDB — graph memory mirror
# FALKORDB_HOST=127.0.0.1
# FALKORDB_PORT=6379
# FALKORDB_PASSWORD=

# Linkup — live web research
# LINKUP_API_KEY=

# LaserData / Apache Iggy — durable event streams
# LASER_URI=iggy://iggy:iggy@127.0.0.1:8090
# LASER_STREAM=continuum
# LASER_LOCAL=1

# Guild.ai — experiment / agent run tracking
# GUILD_API_KEY=
# GUILD_WORKSPACE=continuum

# Snyk — dependency security scanning
# SNYK_TOKEN=
# SNYK_ORG_ID=
