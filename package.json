{
  "name": "continuum",
  "version": "0.1.0",
  "private": true,
  "description": "Continuum — Open Loop OS. Measure Open Loop Debt, close it with Cited Motion, write results back into durable graph memory.",
  "homepage": "https://continuum-memory-meets-motion.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vnmoorthy/continuum-memory-meets-motion.git"
  },
  "bugs": {
    "url": "https://github.com/vnmoorthy/continuum-memory-meets-motion/issues"
  },
  "license": "MIT",
  "author": "vnmoorthy",
  "keywords": [
    "continuum",
    "open-loop-debt",
    "cited-motion",
    "ai-agents",
    "knowledge-graph",
    "memory",
    "stateful-ai",
    "agentic-workflows",
    "nextjs",
    "falkordb",
    "rocketride",
    "linkup",
    "laserdata"
  ],
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --pretty false --incremental false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "snyk:test": "snyk test --severity=true || true",
    "slides": "node scripts/generate-slides.js",
    "ci": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@laserdata/laser-sdk": "^0.0.2",
