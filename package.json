    "date-fns": "^4.4.0",
    "falkordb": "^6.7.0",
    "framer-motion": "^12.43.0",
    "linkup-sdk": "^3.3.2",
    "lucide-react": "^1.28.0",
    "nanoid": "^6.0.1",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rocketride": "^1.3.0",
    "snyk": "^1.1306.2",
    "tailwind-merge": "^3.6.0",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
